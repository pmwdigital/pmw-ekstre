{
  "name": "@pmwdigital/ekstre",
  "version": "0.1.0",
  "description": "Kredi kartı ekstresi satırlarını okuyup harcama, iade, faiz ve ödeme olarak ayırır (Kuveyt Türk, VakıfBank)",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepare": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pmwdigital/pmw-ekstre.git"
  },
  "keywords": [
    "turkey",
    "turkce",
    "ekstre",
    "kredi-karti",
    "credit-card",
    "statement",
    "parser"
  ]
}
